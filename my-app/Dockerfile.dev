# Generated by edgepoint. Do not edit — run `edgepoint sync` instead.
#
# One image for the dev server, one-off commands, and the browser tests.
#
# Playwright's image is the base because it already carries the browsers and
# their system libraries. Installing those by hand is the single most awkward
# dependency in this stack, and its failure mode — a wall of missing .so files —
# is unreadable to the person who would have to fix it.
FROM mcr.microsoft.com/playwright:v1.50.0-noble

ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

# Dependencies are deliberately NOT baked in here. The project source is bind
# mounted at run time and node_modules lives in a named volume, so a scaffolded
# project with no package.json yet still builds. `./edge` installs on first use.
CMD ["npm", "run", "dev"]
