#!/usr/bin/env sh
# Generated by edgepoint. Do not edit — run `edgepoint sync` instead.
#
# The only entry point for running anything in this project. Nothing here needs
# to be installed on your machine except Docker.
set -eu

cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

die() { printf '\n  %s\n\n' "$1" >&2; exit 1; }

command -v docker >/dev/null 2>&1 ||
  die "Docker isn't installed. Install Docker Desktop from docker.com, then try again."

docker info >/dev/null 2>&1 ||
  die "Docker is installed but not running. Start Docker Desktop, wait for it to finish starting, then try again."

# Everything below goes through `dc` rather than calling `docker compose`
# directly, so `./edge guide` can point the same helpers at its own throwaway
# stack without a second copy of any of them.
COMPOSE="docker compose"
dc() { $COMPOSE "$@"; }

# How long to wait for the database. The guide's database is built from scratch
# on every run, so that path raises this.
DB_WAIT=60

# node_modules lives in a named volume, so its presence can only be checked from
# inside a container. Installing on first use means `./edge dev` works on a fresh
# clone without a separate step nobody remembers.
ensure_deps() {
  [ -f package.json ] || return 0
  if ! dc run --rm -T toolbox sh -c '[ -n "$(ls -A node_modules 2>/dev/null)" ]' >/dev/null 2>&1; then
    printf '  Installing dependencies — first run only, this takes a minute.\n\n'
    dc run --rm toolbox npm install
  fi
}

psql_q() { dc exec -T db psql -U postgres -tAq -c "$1" 2>/dev/null | tr -d '[:space:]'; }

wait_for_db() {
  dc up -d db >/dev/null 2>&1
  i=0
  while [ "$(psql_q 'select 1')" != "1" ]; do
    i=$((i + 1))
    [ "$i" -gt "$DB_WAIT" ] && die "The database didn't start. './edge logs db' shows why."
    sleep 1
  done
}

# Applied in filename order, each recorded so it runs exactly once. Tracked in
# the database rather than assumed from a fresh start, so this also works on a
# database that already has data in it.
migrate() {
  [ -d supabase/migrations ] || return 0
  wait_for_db
  dc exec -T db psql -U postgres -v ON_ERROR_STOP=1 -q -c \
    "set client_min_messages to warning;
     create table if not exists _edgepoint_migrations (
       name text primary key,
       applied_at timestamptz not null default now()
     );" >/dev/null 2>&1

  applied=0
  for file in supabase/migrations/*.sql; do
    [ -e "$file" ] || continue
    name="$(basename "$file")"
    [ "$(psql_q "select 1 from _edgepoint_migrations where name = '$name'")" = "1" ] && continue

    printf '  applying %s\n' "$name"
    dc exec -T db psql -U postgres -v ON_ERROR_STOP=1 -q -f "/migrations/$name" ||
      die "Migration $name failed. Fix it, then run './edge migrate' again."
    dc exec -T db psql -U postgres -q -c \
      "insert into _edgepoint_migrations (name) values ('$name');" >/dev/null
    applied=$((applied + 1))
  done
  [ "$applied" -gt 0 ] && printf '  %s migration(s) applied\n\n' "$applied"
  return 0
}

# ---- The printed test guide ---------------------------------------------------
#
# Captured in an environment of its own: a separate compose project, a database
# that exists only in memory, and no published ports. The builder's own data is
# never touched and never photographed, and this can run while `./edge dev` is up.
#
# Torn down however this ends, including a cancelled run.
guide_cleaned=0
guide_teardown() {
  if [ "$guide_cleaned" = 0 ]; then
    guide_cleaned=1
    printf '\n  Clearing the test environment.\n'
    # Containers and network go; the named volume holding node_modules stays, so
    # the next guide doesn't reinstall. The database was never on a volume.
    dc down --remove-orphans >/dev/null 2>&1 || true
  fi
}

# A signal handler has to end the script itself. Tidying up and returning would
# drop the shell back into whatever it was doing — waiting for a database that
# has just been removed — and Ctrl-C would look like it did nothing.
guide_interrupted() {
  guide_teardown
  exit 130
}

guide() {
  [ -f compose.guide.yaml ] ||
    die "This project has no compose.guide.yaml, so there's nowhere to capture a guide. That needs a developer to add."
  [ -f playwright.guide.config.ts ] ||
    die "There's no test guide set up in this project yet. Ask your AI tool to make one."

  # Compose derives a project name from the directory; this one is spelled out so
  # it cannot collide with the dev stack.
  project="$(basename "$PWD" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g')-guide"
  COMPOSE="docker compose -f compose.guide.yaml -p $project"
  DB_WAIT=240

  trap guide_teardown EXIT
  trap guide_interrupted INT TERM HUP

  printf '\n  Setting up a clean test environment. Your own data is left alone.\n\n'
  wait_for_db
  ensure_deps
  migrate

  if [ -f tests/guide/seed.sql ]; then
    dc exec -T db psql -U postgres -v ON_ERROR_STOP=1 -q < tests/guide/seed.sql ||
      die "The guide's test data wouldn't load — tests/guide/seed.sql is the file."
  fi

  dc up -d app >/dev/null

  printf '  Walking through the app and taking the screenshots.\n\n'
  status=0
  dc run --rm -T toolbox npx playwright test -c playwright.guide.config.ts "$@" || status=1

  if [ "$status" = 0 ]; then
    printf '\n  Guide written to test-guide/.\n'
  else
    printf '\n  The walkthrough stopped early — the guide is missing or incomplete.\n'
  fi

  guide_teardown
  trap - EXIT INT TERM HUP
  printf '\n'
  return "$status"
}

usage() {
  cat <<'USAGE'

  ./edge dev            start the app — http://localhost:3000
  ./edge stop           stop everything
  ./edge test           run the acceptance tests
  ./edge guide          build the printed test guide, in a throwaway environment
  ./edge npm <args>     run npm inside the container
  ./edge npx <args>     run npx inside the container
  ./edge psql           open the database
  ./edge migrate        apply any new database changes
  ./edge shell          a shell inside the container
  ./edge reset          wipe the local database and replay migrations
  ./edge logs           watch what the app is doing
  ./edge build          rebuild the container image

USAGE
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
  dev|up)   ensure_deps; migrate; exec $COMPOSE up "$@" ;;
  stop|down) exec $COMPOSE down "$@" ;;
  test)     ensure_deps; migrate; exec $COMPOSE run --rm toolbox npx playwright test "$@" ;;
  guide)    guide "$@" ;;
  npm)      exec $COMPOSE run --rm toolbox npm "$@" ;;
  npx)      exec $COMPOSE run --rm toolbox npx "$@" ;;
  migrate)  migrate ;;
  psql)     wait_for_db; exec $COMPOSE exec db psql -U postgres "$@" ;;
  shell)    exec $COMPOSE run --rm toolbox bash "$@" ;;
  logs)     exec $COMPOSE logs -f "$@" ;;
  build)    exec $COMPOSE build "$@" ;;
  reset)
    printf '  Wiping the local database and replaying migrations.\n'
    printf '  This only affects your machine — production is untouched.\n\n'
    dc down -v
    migrate
    printf '  Fresh database ready.\n\n'
    ;;
  help|-h|--help) usage ;;
  *) printf '\n  Unknown command: %s\n' "$cmd" >&2; usage; exit 1 ;;
esac
