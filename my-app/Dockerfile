# Generated by edgepoint. Do not edit — run `edgepoint sync` instead.
#
# Production image. Built by GitHub Actions on x86, never on the server: the
# $7 Lightsail box has 1 GB of RAM and `next build` needs several times that.
# The server only ever pulls and runs this.

FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-bookworm-slim AS run
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# 1 GB total on the box, shared with Postgres and Caddy. Without a ceiling, V8
# sizes its heap against the whole machine and the OOM killer picks a victim.
ENV NODE_OPTIONS=--max-old-space-size=384

RUN groupadd --system --gid 1001 nodejs \
 && useradd --system --uid 1001 --gid nodejs nextjs

# `output: 'standalone'` in next.config — a self-contained server with only the
# modules it actually uses, which is what makes this fit in the memory left over.
COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=build --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
