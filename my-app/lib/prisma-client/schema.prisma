model Expense {
  id          Int             @id @default(autoincrement())
  categoryId  Int
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  userId      Int
  user        User            @relation(fields: [userId], references: [id])
  supplierId  Int?
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  amount      Float
  description String?
  expenseDate DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId])
  @@index([supplierId])
  @@index([userId])
}

// -- HR: Shift templates --
model Shift {
  id           Int        @id @default(autoincrement())
  name         String
  startTime    String // "06:00"
  endTime      String // "14:00"
  breakMinutes Int        @default(0)
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  schedules    Schedule[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([name])
}

// -- HR: Per-staff shift assignments --
model Schedule {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId   Int
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  date      DateTime // the specific work date
  status    String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, CANCELLED, SWAP_REQUESTED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}

// -- HR: Clock-in / clock-out records --
model Attendance {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleId Int?
  clockIn    DateTime
  clockOut   DateTime?
  breakStart DateTime?
  breakEnd   DateTime?
  totalHours Float? // calculated on clock-out
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([clockIn])
}

// -- HR: Leave types (Sick, Vacation, etc.) --
model LeaveType {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  daysPerYear Int            @default(0)
  isActive    Boolean        @default(true)
  requests    LeaveRequest[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// -- HR: Leave requests with approve/reject workflow --
model LeaveRequest {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId  Int
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById Int?
  approvedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

// -- HR: Payroll per period --
model Payroll {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  regularHours  Float     @default(0)
  overtimeHours Float     @default(0)
  grossPay      Float     @default(0)
  deductions    Float     @default(0)
  netPay        Float     @default(0)
  status        String    @default("DRAFT") // DRAFT, PROCESSED, PAID
  processedById Int?
  processedAt   DateTime?
  notes         String?
  breakdown     String? // JSON: PH statutory deduction breakdown (SSS/PhilHealth/Pag-IBIG/tax)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

// -- HR: Performance reviews --
model PerformanceReview {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation("Reviewee", fields: [userId], references: [id], onDelete: Cascade)
  reviewerId   Int
  reviewer     User     @relation("Reviewer", fields: [reviewerId], references: [id])
  period       String // e.g. "Q1 2026" or "2026-01"
  rating       Int // 1-5
  strengths    String?
  improvements String?
  goals        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([reviewerId])
}

// -- HR: Staff documents (contracts, certs, NDAs) --
model StaffDocument {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation("DocOwner", fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         String    @default("OTHER") // CONTRACT, NDA, CERTIFICATION, OTHER
  fileUrl      String?
  expiryDate   DateTime?
  uploadedById Int?
  uploader     User?     @relation("DocUploader", fields: [uploadedById], references: [id])
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

// -- HR: Training courses --
model Training {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  duration    String? // e.g. "2 hours", "1 day"
  isActive    Boolean         @default(true)
  enrollments StaffTraining[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// -- HR: Staff enrollment in training courses --
model StaffTraining {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingId  Int
  training    Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  status      String    @default("ENROLLED") // ENROLLED, IN_PROGRESS, COMPLETED
  completedAt DateTime?
  expiryDate  DateTime? // for certifications that expire
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, trainingId])
}
