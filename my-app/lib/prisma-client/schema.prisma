// Groups ("Size", "Temperature", "Add-ons"ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¦) hold priced options and are
// attached to products. Products with no attached groups sell exactly as
// before ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â a single base price, no prompts.

model OptionGroup {
  id             Int                  @id @default(autoincrement())
  name           String               @unique
  selectionType  String               @default("single")
  sortOrder      Int                  @default(0)
  available      Boolean              @default(true)
  products       ProductOptionGroup[]
  productOptions ProductOption[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

// Per-product options: each product defines its OWN options under an
// attached group, with peso adders and optional ingredient add-ons
// (in the recipe's units) applied on top of the base recipe.
model ProductOption {
  id          Int                       @id @default(autoincrement())
  productId   Int
  product     Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupId     Int
  group       OptionGroup               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  priceDelta  Float                     @default(0)
  sortOrder   Int                       @default(0)
  available   Boolean                   @default(true)
  ingredients ProductOptionIngredient[]
  createdAt   DateTime                  @default(now())

  @@unique([productId, groupId, name])
  @@index([groupId])
}

model ProductOptionIngredient {
  id              Int           @id @default(autoincrement())
  productOptionId Int
  productOption   ProductOption @relation(fields: [productOptionId], references: [id], onDelete: Cascade)
  ingredientId    Int
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  deltaQty        Float
  createdAt       DateTime      @default(now())

  @@unique([productOptionId, ingredientId])
}

model ProductOptionGroup {
  productId Int
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupId   Int
  group     OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sortOrder Int         @default(0)

