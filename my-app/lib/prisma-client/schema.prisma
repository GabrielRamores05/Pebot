model User {
  id                    Int       @id @default(autoincrement())
  name                  String
  email                 String    @unique
  password              String
  role                  String    @default("STAFF") // ADMIN, STAFF, KITCHEN
  active                Boolean   @default(true)
  permissions           String    @default("{\"liveOrders\":true,\"terminal\":false,\"tables\":false,\"analytics\":false,\"products\":false,\"inventory\":false,\"kitchen\":false,\"loyalty\":false,\"staff\":false,\"settings\":false}") // JSON string of permissions
  subscriptionId        Int?      @unique
  // HR profile fields
  phone                 String?
  address               String?
  dateOfBirth           DateTime?
  hireDate              DateTime?
  position              String? // Barista, Cashier, Kitchen Staff, Shift Supervisor, Manager
  department            String? // Front of House, Back of House, Management
  profilePhoto          String?
  emergencyContactName  String?
  emergencyContactPhone String?
  hourlyRate            Float?
  monthlySalary         Float?
  paymentType           String? // HOURLY, SALARIED

  // HR back-relations
  schedules       Schedule[]
  attendance      Attendance[]
  leaveRequests   LeaveRequest[]
  payrolls        Payroll[]
  reviewsReceived PerformanceReview[] @relation("Reviewee")
  reviewsGiven    PerformanceReview[] @relation("Reviewer")
  documents       StaffDocument[]     @relation("DocOwner")
  uploadedDocs    StaffDocument[]     @relation("DocUploader")
  staffTrainings  StaffTraining[]
  subscription    Subscription?       @relation("UserSubscription", fields: [subscriptionId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  POSLicense      POSLicense[]        @relation("UserPOSLicense")
  auditLogs       AuditLog[]
  aiConversations AIConversation[]
