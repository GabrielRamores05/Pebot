# HTTPS is automatic. Certificates arrive without anyone requesting one.

{
	email {$ACME_EMAIL}

	# Tenant subdomains and customers' own domains both get their certificate on
	# the first request to them, rather than being listed here in advance.
	#
	# `ask` is not optional and not a formality: without it, anyone who points a
	# DNS record at this server makes it request a certificate on their behalf,
	# and Let's Encrypt will rate-limit the whole box. The app answers 200 only
	# for a hostname it recognises as a tenant's.
	# Current Caddy rate-limits issuance itself; the old `interval`/`burst`
	# options were removed and are now a hard config error.
	on_demand_tls {
		ask http://app:3000/api/tls-allowed
	}
}

# The main site. A normal certificate, issued at startup.
{$APP_DOMAIN}, www.{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

# Everything else: acme.yourapp.com, and app.acmecorp.com. One deployment
# serves all of them — the app works out which tenant from the Host header.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:3000
}
