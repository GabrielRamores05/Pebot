# Database connection string.
# Local development: "file:./dev.db" (SQLite, created in prisma/)
# Docker (Postgres): "postgresql://postgres:postgres@db:5432/postgres"
DATABASE_URL=

# JWT signing secret for session tokens.
# Generate with: openssl rand -base64 32
# In Electron production, falls back to a machine-derived secret if unset.
JWT_SECRET=

# WebSocket URL for the Socket.IO client.
# Usually the same as the app origin, e.g. "http://smartcafeos.local:3000"
NEXT_PUBLIC_WS_URL=

# Base URL for customer QR menu links.
# e.g. "http://smartcafeos.local:3000" or "https://yourdomain.com"
NEXT_PUBLIC_MENU_BASE_URL=

# Application domain used for TLS/certificate checks.
APP_DOMAIN=

# Server port (default: 3000)
PORT=3000
